---
import VideoEmbed from "@/components/VideoEmbed.astro";
import { narration } from "@/data/solarDelayNarration";
import PageLayout from "@/layouts/Base.astro";

// After uploading to Vimeo, paste the numeric video ID here.
// For an unlisted video, also paste the privacy hash (the token after "?h=" or the
// last path segment of the share link, e.g. vimeo.com/123456789/abcdef0123 -> "abcdef0123").
const VIMEO_ID = "1210539319";
const VIMEO_HASH = "";

const meta = {
	title: "The Hidden Costs of Solar Delay",
	description:
		"A narrated talk on the double climate cost of building solar too slowly in Massachusetts. More fossil emissions now, a heavier forest carbon burden later.",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-2">The Hidden Costs of Solar Delay</h1>
	<p class="text-accent mb-8">Less clean electricity today, greater forest burdens tomorrow.</p>

	<VideoEmbed
		id={VIMEO_ID}
		hash={VIMEO_HASH}
		title="The Hidden Costs of Solar Delay, a narrated presentation"
	/>

	<div class="prose prose-sm prose-cactus mt-10 max-w-none">
		<p>
			John Pepi made this presentation for the Western Massachusetts Clean Energy Network. It
			works out the carbon consequences if Massachusetts protects its forests but builds solar
			more slowly than its climate plan requires.
		</p>
		<p>
			The talk runs about nineteen minutes and uses state planning data. It follows a scenario
			in which solar deployment reaches 80 percent of the targets set for 2026 through 2050.
			Over those 25 years the state loses 116 terawatt-hours of clean electricity, emits 32
			million metric tons of carbon dioxide its carbon budget never counted, and needs roughly
			88,000 additional forest acres to absorb the difference. The full narration follows the
			video.
		</p>

		<details class="mt-8">
			<summary class="cursor-pointer font-semibold">Transcript</summary>
			<div class="mt-4">
				{
					narration.map((section) => (
						<Fragment>
							{section.heading && <h3>{section.heading}</h3>}
							<p>{section.text}</p>
						</Fragment>
					))
				}
			</div>
		</details>
	</div>

	<p class="mt-12 text-sm">
		Topics:
		<a class="cactus-link inline-block before:content-['#']" href="/tags/forest-carbon/">forest-carbon</a>,
		<a class="cactus-link inline-block before:content-['#']" href="/tags/solar/">solar</a>
	</p>
	<p class="mt-4">
		<a href="/posts/" class="text-link">Back to Articles</a>
	</p>
</PageLayout>
